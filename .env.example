# Copy to `.env` and fill in. `.env` is gitignored; never commit a real key.
#
# Both can be the SAME key, as long as you enable all three APIs on it in
# Google Cloud Console: Places API (New), Maps SDK for iOS, Maps SDK for Android.
#
# Leave a line out entirely rather than setting it to a placeholder — a
# non-empty but invalid key makes the app attempt a live request, fail, and
# fall back to sample data with an error, which is more confusing than no key.

# Restaurant listings. Read at runtime; also settable in-app (You -> Listings).
# Needs: Places API (New)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# The map tiles. Baked in at build time, so changing it needs a restart/rebuild.
# Needs: Maps SDK for iOS + Maps SDK for Android
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
